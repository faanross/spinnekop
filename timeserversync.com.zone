    $TTL 3600
    @   IN  SOA ns1.timeserversync.com. admin.timeserversync.com. (
            1          ; Serial
            3600       ; Refresh
            1800       ; Retry
            604800     ; Expire
            86400      ; Minimum TTL
    )

    ; Name Servers
    @   IN  NS  ns1.timeserversync.com.

    ; A Records for the domain and nameserver
    @   IN  A   64.23.212.29
    ns1 IN  A   64.23.212.29